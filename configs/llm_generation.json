{
  "endpoint_env": "PCR_LLM_ENDPOINT",
  "default_endpoint": "https://<openai-compatible-gateway>/v1/chat/completions",
  "api_key_env_by_model_prefix": {
    "glm": "GLM_API_KEY",
    "deepseek": "DEEPSEEK_API_KEY"
  },
  "fallback_api_key_env": "PCR_API_KEY",
  "request": {
    "temperature": 0,
    "top_p": 0.9,
    "thinking": {"type": "enabled"},
    "stream": false
  },
  "note": "Request settings follow the version-1 runs (run_ieee_manifest.py) unless the specification says otherwise.",
  "timeout_seconds": 300,
  "max_retries": 3
}
